# KisanSaarthi environment variables
# Copy to .env and fill in your keys:
#   Copy-Item .env.example .env

APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Required for AI chat + crop leaf analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional – live mandi prices (falls back to cached sample data)
AGMARKNET_API_KEY=

# Optional – confidence threshold for grounded answers
CONFIDENCE_THRESHOLD=0.55

# SQLite database (created automatically on startup)
DATABASE_URL=sqlite:///./kisansaarthi.db
